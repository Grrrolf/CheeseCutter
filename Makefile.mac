#LIBS=/opt/ldc/build/lib/libphobos-ldc.a /opt/ldc/build/lib/libdruntime-ldc.a -lstdc++
#LIBS=/opt/ldc2/lib/libphobos-ldc.a /opt/ldc2/lib/libdruntime-ldc.a -lstdc++
ifneq ($(wildcard /opt/homebrew/lib/libphobos2-ldc.a),)
LIBS=/opt/homebrew/lib/libphobos2-ldc.a /opt/homebrew/lib/libdruntime-ldc.a -lstdc++ -lsdl2
else ifneq ($(wildcard /opt/local/lib/libphobos2-ldc.a),)
LIBS=/opt/local/lib/libphobos2-ldc.a /opt/local/lib/libdruntime-ldc.a -lstdc++ -lsdl2
else
LIBS=/usr/local/lib/libphobos2-ldc.a /usr/local/lib/libdruntime-ldc.a -lstdc++ -lsdl2
endif

ifneq ($(wildcard /opt/homebrew/lib/libSDL2-2.0.0.dylib),)
SDL_LIB=/opt/homebrew/lib/libSDL2-2.0.0.dylib
else ifneq ($(wildcard /opt/local/lib/libSDL2-2.0.0.dylib),)
SDL_LIB=/opt/local/lib/libSDL2-2.0.0.dylib
else
SDL_LIB=/usr/local/lib/libSDL2-2.0.0.dylib
endif
FRAMEWORKS=-framework Foundation
COMFLAGS= -mmacosx-version-min=11.0 -g
ifneq ($(wildcard /opt/homebrew/lib),)
COMFLAGS += -L/opt/homebrew/lib -I/opt/homebrew/include
endif
ifneq ($(wildcard /opt/local/lib),)
COMFLAGS += -L/opt/local/lib -I/opt/local/include
endif
VERSION=$(shell cat Version)
DLINK=$(COMFLAGS)
DFLAGS=-d-version=DerelictSDL2_Static -I./src -J./src/c64 -J./src/font
CFLAGS=$(COMFLAGS)
CXXFLAGS=$(CFLAGS) -I./src -O2
LDFLAGS=-rpath,@executable_path/../Frameworks
COMPILE.d = $(DC) $(DFLAGS) -d -O2 -c -of=$@
DC=ldc2
EXE=
TARGET=ccutter

include Makefile.objects.mk

BUILD_DIR = build
DIST_DIR = dist

BUILD_OBJS = $(addprefix $(BUILD_DIR)/, $(OBJS))
BUILD_CXX_OBJS = $(addprefix $(BUILD_DIR)/, $(CXX_OBJS))
BUILD_C_OBJS = $(addprefix $(BUILD_DIR)/, $(C_OBJS))
BUILD_UTILOBJS = $(addprefix $(BUILD_DIR)/, $(UTILOBJS))

.PHONY: help install release dist clean dclean tar ccutter ct2util test

$(BUILD_DIR)/%.o: %.d
	@mkdir -p $(dir $@)
	$(COMPILE.d) $<

$(BUILD_DIR)/%.o: %.cpp
	@mkdir -p $(dir $@)
	$(CXX) $(CXXFLAGS) -c $< -o $@

$(BUILD_DIR)/%.o: %.c
	@mkdir -p $(dir $@)
	$(CC) -c $< -o $@

$(DIST_DIR)/$(TARGET): $(C64OBJS) $(BUILD_OBJS) $(BUILD_CXX_OBJS)
	@mkdir -p $(DIST_DIR)
	$(CC) $(DLINK) -Wl,$(LDFLAGS) -o $@ $(BUILD_OBJS) $(BUILD_CXX_OBJS) $(LIBS) $(FRAMEWORKS)

ct: $(C64OBJS) $(CTOBJS)

$(DIST_DIR)/ct2util: $(C64OBJS) $(BUILD_UTILOBJS)
	@mkdir -p $(DIST_DIR)
	$(CC) $(DLINK) -Wl,$(LDFLAGS) -o $@ $(BUILD_UTILOBJS) $(LIBS)

c64: $(C64OBJS)

all: c64 $(BUILD_OBJS) $(BUILD_CXX_OBJS) $(DIST_DIR)/ct2util ct $(DIST_DIR)/$(TARGET)

ccutter: $(DIST_DIR)/$(TARGET)
ct2util: $(DIST_DIR)/ct2util

release: all
	strip $(DIST_DIR)/ccutter$(EXE)
	strip $(DIST_DIR)/ct2util$(EXE)

	rm -rf $(DIST_DIR)/CheeseCutter.app
	mkdir -p $(DIST_DIR)/CheeseCutter.app/Contents/Frameworks
	mkdir -p $(DIST_DIR)/CheeseCutter.app/Contents/MacOS
	cp -r arch/MacOS/Contents $(DIST_DIR)/CheeseCutter.app
	cp $(SDL_LIB) $(DIST_DIR)/CheeseCutter.app/Contents/Frameworks/libSDL2-2.0.0.dylib
	cp $(DIST_DIR)/$(TARGET) $(DIST_DIR)/CheeseCutter.app/Contents/MacOS
	cp $(DIST_DIR)/ct2util $(DIST_DIR)/CheeseCutter.app/Contents/MacOS
	install_name_tool -id @rpath/libSDL2-2.0.0.dylib $(DIST_DIR)/CheeseCutter.app/Contents/Frameworks/libSDL2-2.0.0.dylib
	for bin in $(DIST_DIR)/CheeseCutter.app/Contents/MacOS/ccutter $(DIST_DIR)/CheeseCutter.app/Contents/MacOS/ct2util; do \
		REAL_SDL_PATH=$$(otool -L $$bin | grep -o '/.*libSDL2-2.0.0.dylib' | head -n 1); \
		if [ ! -z "$$REAL_SDL_PATH" ]; then \
			install_name_tool -change "$$REAL_SDL_PATH" @rpath/libSDL2-2.0.0.dylib $$bin; \
		fi; \
		codesign --force --sign - $$bin; \
	done
	codesign --force --sign - $(DIST_DIR)/CheeseCutter.app/Contents/Frameworks/libSDL2-2.0.0.dylib

dist:	release
	rm -rf $(DIST_DIR)/CheeseCutter_$(VERSION).dmg
	arch/makedmg.sh

test: all
	@echo "Running smoke tests..."
	$(DIST_DIR)/$(TARGET) -h > /dev/null
	$(DIST_DIR)/ct2util > /dev/null
	@echo "Smoke tests passed!"

help:
	@echo "Available targets (macOS):"
	@echo "  all          - Build ccutter and ct2util"
	@echo "  ccutter      - Build ccutter"
	@echo "  ct2util      - Build ct2util"
	@echo "  test         - Run basic smoke tests"
	@echo "  release      - Build and create app bundle"
	@echo "  dist         - Create macOS DMG"
	@echo "  clean        - Remove build objects"
	@echo "  dclean       - Remove build and dist directories"

clean:
	rm -rf $(BUILD_DIR)
	rm -f *~ src/*~ src/*/*~

dclean: clean
	rm -rf $(DIST_DIR)

tar:
	@mkdir -p $(DIST_DIR)
	git archive master --prefix=cheesecutter-$(VERSION)/ | bzip2 > $(DIST_DIR)/cheesecutter-$(VERSION)-macosx-src.tar.bz2
# --------------------------------------------------------------------------------

src/c64/player.bin: src/c64/player_v4.acme
	acme -f cbm --outfile $@ $<

$(BUILD_DIR)/src/ct/base.o: src/c64/player.bin
$(BUILD_DIR)/src/ui/ui.o: $(BUILD_DIR)/src/ui/help.o



