# Makefile.win32 for CheeseCutter
# Re-created for modern ldc2/clang build on Windows

DC = ldc2
CC = cl
CXX = cl
EXE = .exe
OBJ = .obj

BUILD_DIR = build
DIST_DIR = dist

# Using dynamic loading for SDL2 on Windows (no -d-version=DerelictSDL2_Static)
DFLAGS = -I./src -J./src/c64 -J./src/font -O
CFLAGS = /nologo /O2 /I./src /c /Fo$@
CXXFLAGS = /nologo /O2 /I./src /c /EHsc /Fo$@
# Link against standard C++ lib if needed
DLIBS =

include Makefile.objects.mk

# Map .o to .obj for Windows
WIN_OBJS = $(addprefix $(BUILD_DIR)/, $(subst .o,$(OBJ),$(OBJS)))
WIN_CXX_OBJS = $(addprefix $(BUILD_DIR)/, $(subst .o,$(OBJ),$(CXX_OBJS)))
WIN_C_OBJS = $(addprefix $(BUILD_DIR)/, $(subst .o,$(OBJ),$(C_OBJS)))
WIN_UTILOBJS = $(addprefix $(BUILD_DIR)/, $(subst .o,$(OBJ),$(UTILOBJS)))

.PHONY: all clean dclean test help

help:
	@echo "Available targets (Windows):"
	@echo "  all          - Build ccutter.exe and ct2util.exe"
	@echo "  test         - Run basic smoke tests"
	@echo "  clean        - Remove build objects"
	@echo "  dclean       - Remove build and dist directories"

$(BUILD_DIR)/%$(OBJ): %.d
	$(DC) $(DFLAGS) -c -of=$@ $<

$(BUILD_DIR)/%$(OBJ): %.c
	$(CC) $(CFLAGS) $<

$(BUILD_DIR)/%$(OBJ): %.cpp
	$(CXX) $(CXXFLAGS) $<

all: $(DIST_DIR)/ccutter$(EXE) $(DIST_DIR)/ct2util$(EXE)

$(DIST_DIR)/ccutter$(EXE): $(WIN_OBJS) $(WIN_CXX_OBJS)
	$(DC) -of=$@ $(WIN_OBJS) $(WIN_CXX_OBJS) $(DLIBS)

$(DIST_DIR)/ct2util$(EXE): $(WIN_UTILOBJS)
	$(DC) -of=$@ $(WIN_UTILOBJS)

test: all
	@echo "Running smoke tests..."
	$(DIST_DIR)/ccutter$(EXE) -h > /dev/null
	$(DIST_DIR)/ct2util$(EXE) > /dev/null
	@echo "Smoke tests passed!"

clean:
	rm -rf $(BUILD_DIR)

dclean: clean
	rm -rf $(DIST_DIR)
